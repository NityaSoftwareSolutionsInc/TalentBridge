DATABASE_URL="postgresql://talentbridge:talentbridge@127.0.0.1:5435/talentbridge?schema=talentbridge"
AUTH_JWT_SECRET="change-me-to-a-long-random-string"
STUB_AUTH_SECRET="talentbridge-poc-stub"
APP_BASE_URL="http://localhost:3011"
# For docker compose (see .env.docker.example): ADMIN_APP_BASE_URL + public HTTPS URLs
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@example.com"
# Optional display name in the inbox (Gmail letter avatar uses the first letter of this name)
# SENDGRID_FROM_NAME="TalentBridge"
# JobsNProfiles one-way sync (HTTP). When both are set, live adapter is used; otherwise stub fixtures.
# API key authenticates TalentBridge as a service. Entitlement (active recruiter + live subscription)
# is refreshed at TalentBridge login (non-blocking) and again when the snapshot is older than 2 hours.
# Sync/preview still send requester_user_id; they are rate-limited per user and tenant.
JNP_API_BASE_URL=""
JNP_API_KEY=""
# Deep-link base for "Open JobsNProfiles" (client-visible). Appends /{portalCandidateId}.
# Or use a template with {id}, e.g. https://admin.jobsnprofiles.com/resume/{id}
NEXT_PUBLIC_JNP_PROFILE_BASE_URL="https://jobsnprofiles.com/employer/candidate-profile"
# Optional comma-separated extra hosts allowed for Open JobsNProfiles (https only)
# NEXT_PUBLIC_JNP_ALLOWED_HOSTS="staging.jobsnprofiles.com"
# Microsoft Graph — multi-tenant delegated OAuth (Connect Outlook).
# Register an Azure AD app: Accounts in any organizational directory (multi-tenant).
# Delegated permissions + admin consent: Mail.ReadWrite, Mail.Send, Calendars.ReadWrite, User.Read, offline_access, openid, profile, email
# Redirect URI (Web): {APP_BASE_URL}/api/integrations/microsoft/callback
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
# Optional; defaults to {APP_BASE_URL}/api/integrations/microsoft/callback
# MICROSOFT_GRAPH_REDIRECT_URI="https://your-host/api/integrations/microsoft/callback"
# Optional authority segment (default organizations = any work/school tenant)
# MICROSOFT_GRAPH_AUTHORITY="organizations"
# Optional override (defaults to https://graph.microsoft.com/v1.0)
# MICROSOFT_GRAPH_BASE_URL="https://graph.microsoft.com/v1.0"
# Local folder for uploaded resumes/docs (default: data/uploads)
# FILE_STORAGE_PATH="data/uploads"
