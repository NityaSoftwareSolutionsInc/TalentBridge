DATABASE_URL="postgresql://talentbridge:talentbridge@localhost:5433/talentbridge?schema=talentbridge"
AUTH_JWT_SECRET="change-me-to-a-long-random-string"
STUB_AUTH_SECRET="talentbridge-poc-stub"
APP_BASE_URL="http://localhost:3001"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@example.com"
# JobsNProfiles one-way sync (HTTP). When both are set, live adapter is used; otherwise stub fixtures.
# API key authenticates TalentBridge as a service. Entitlement (active recruiter + live subscription)
# is refreshed at TalentBridge login (non-blocking) and again when the snapshot is older than 2 hours.
# Sync/preview still send requester_user_id; they are rate-limited per user and tenant.
JNP_API_BASE_URL=""
JNP_API_KEY=""
# Deep-link base for "Open JobsNProfiles" (client-visible). Appends /{portalCandidateId}.
# Or use a template with {id}, e.g. https://admin.jobsnprofiles.com/resume/{id}
NEXT_PUBLIC_JNP_PROFILE_BASE_URL="https://jobsnprofiles.com"
# Optional comma-separated extra hosts allowed for Open JobsNProfiles (https only)
# NEXT_PUBLIC_JNP_ALLOWED_HOSTS="staging.jobsnprofiles.com"
# Microsoft Graph (Outlook send/read + Teams meetings). When all three are set, live adapter is used; otherwise stub.
# Azure AD app needs application permissions (admin consent): Mail.Send, Mail.Read, Calendars.ReadWrite
MICROSOFT_GRAPH_TENANT_ID=""
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
# Optional override (defaults to https://graph.microsoft.com/v1.0)
# MICROSOFT_GRAPH_BASE_URL="https://graph.microsoft.com/v1.0"
