# Copy to .env next to docker-compose.yml before: docker compose up -d --build
# DATABASE_URL is overridden inside containers to use host `db`.

# Path to Admin app (relative to this compose file). Must contain Dockerfile.
# Default: ../Admin-Talent-Bridge
# ADMIN_BUILD_CONTEXT=../AdminTalentBridge

AUTH_JWT_SECRET="change-me-to-a-long-random-string-min-16-chars"
STUB_AUTH_SECRET="talentbridge-poc-stub"

# Public URLs (Nginx / HTTPS)
APP_BASE_URL="https://dtalentbridge.d3e.studio"
ADMIN_APP_BASE_URL="https://dadmintalentbridge.d3e.studio"

SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@d3e.studio"

JNP_API_BASE_URL=""
JNP_API_KEY=""
NEXT_PUBLIC_JNP_PROFILE_BASE_URL="https://jobsnprofiles.com"
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
# MICROSOFT_GRAPH_REDIRECT_URI="https://dtalentbridge.d3e.studio/api/integrations/microsoft/callback"
# MICROSOFT_GRAPH_AUTHORITY="organizations"

# Uploaded resumes/docs inside the app container (compose mounts a named volume here)
FILE_STORAGE_PATH=/data/uploads
