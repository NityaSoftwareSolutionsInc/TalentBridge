generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["talentbridge"]
}

enum TbRole {
  recruiter
  sales
  operations
  leadership
  admin

  @@schema("talentbridge")
}

enum PersonKind {
  candidate
  client_person
  vendor_person

  @@schema("talentbridge")
}

enum OrganizationRoleKind {
  client
  vendor

  @@schema("talentbridge")
}

enum RequirementStatus {
  open
  on_hold
  filled
  cancelled

  @@schema("talentbridge")
}

enum WrapUpOutcome {
  next_action
  no_action_required
  closed

  @@schema("talentbridge")
}

enum OwnershipRequestType {
  collaboration
  transfer

  @@schema("talentbridge")
}

enum OwnershipRequestStatus {
  pending
  accepted
  dismissed

  @@schema("talentbridge")
}

enum ExceptionKind {
  unmatched_mail
  unmatched_call
  duplicate
  failed_sync

  @@schema("talentbridge")
}

enum InsightStatus {
  proposed
  accepted
  dismissed

  @@schema("talentbridge")
}

model PlatformAdmin {
  id                     String    @id @default(uuid())
  email                  String    @unique
  name                   String
  passwordHash           String    @map("password_hash")
  enabled                Boolean   @default(true)
  createdAt              DateTime  @default(now()) @map("created_at")
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  mustChangePassword     Boolean   @default(false) @map("must_change_password")
  passwordChangedAt      DateTime? @map("password_changed_at")
  lastLoginAt            DateTime? @map("last_login_at")
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  lockedUntil            DateTime? @map("locked_until")
  inviteSentAt           DateTime? @map("invite_sent_at")

  @@map("platform_admins")
  @@schema("talentbridge")
}

model Tenant {
  id                  String   @id @default(uuid())
  name                String
  enabled             Boolean  @default(true)
  /// Platform entitlement: JobsNProfiles is available in this tenant. Set by Global Admin.
  jnpAllowed          Boolean  @default(false) @map("jnp_allowed")
  outlookAllowed      Boolean  @default(true) @map("outlook_allowed")
  viotalkAllowed      Boolean  @default(true) @map("viotalk_allowed")
  maintenanceMode     Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage  String   @default("") @map("maintenance_message")
  legalName           String   @default("") @map("legal_name")
  billingContact      String   @default("") @map("billing_contact")
  region              String   @default("")
  notes               String   @default("")
  accountOwner        String   @default("") @map("account_owner")
  createdAt           DateTime @default(now()) @map("created_at")

  users            User[]
  memberships      Membership[]
  settings         TenantSettings?
  organizations    Organization[]
  people           Person[]
  requirements     Requirement[]
  submissions      Submission[]
  activityEvents   ActivityEvent[]
  tasks            Task[]
  insights         Insight[]
  files            StoredFile[]
  msaDocuments     MsaDocument[]
  purchaseOrders   PurchaseOrder[]
  provenance       Provenance[]
  auditEvents      AuditEvent[]
  titleIndexes     TitleIndex[]
  ownershipReqs    OwnershipRequest[]
  exceptions       ExceptionItem[]
  agentMaps        VioTalkAgentMap[]
  mailboxMaps      MailboxMap[]
  jnpUserMaps      JnpUserMap[]
  interviews       Interview[]
  placements       Placement[]
  externalLinks    ExternalEntityLink[]
  calendarEvents   CalendarEvent[]
  emailSignatures  EmailSignature[]

  @@map("tenants")
  @@schema("talentbridge")
}

model TenantSettings {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique @map("tenant_id")
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relationshipStages       String[] @default(["Lead", "Suspect", "Prospect", "Customer"]) @map("relationship_stages")
  submissionStages         String[] @default(["Submitted", "Client Review", "Interview", "Rejected", "Offer", "Placement"]) @map("submission_stages")
  slaRequirementNoSubDays  Int      @default(3) @map("sla_requirement_no_sub_days")
  slaSubmissionFeedbackDays Int     @default(5) @map("sla_submission_feedback_days")
  slaInterviewFeedbackDays Int      @default(1) @map("sla_interview_feedback_days")
  slaClientLastOutreachDays Int      @default(21) @map("sla_client_last_outreach_days")
  slaMsaExpiryDays         Int      @default(30) @map("sla_msa_expiry_days")
  recordingPlaybackAllowed Boolean  @default(false) @map("recording_playback_allowed")
  /// JobsNProfiles employer account (jnp_users.id) used when a TalentBridge user has no personal JNP map.
  jnpAccountUserId         String   @default("") @map("jnp_account_user_id")

  @@map("tenant_settings")
  @@schema("talentbridge")
}

model User {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  name          String
  title         String   @default("")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  lastLoginAt   DateTime? @map("last_login_at")
  passwordHash            String?   @map("password_hash")
  passwordSetAt           DateTime? @map("password_set_at")
  inviteSentAt            DateTime? @map("invite_sent_at")
  passwordResetTokenHash  String?   @map("password_reset_token_hash")
  passwordResetExpiresAt  DateTime? @map("password_reset_expires_at")
  passwordResetKind       String?   @map("password_reset_kind")
  /// When false, this user does not see JobsNProfiles candidate sync in the workspace.
  jnpEnabled              Boolean   @default(false) @map("jnp_enabled")
  /// Snapshot from JobsNProfiles /authenticate at TalentBridge login (not rechecked on each sync).
  jnpAccessOk             Boolean   @default(false) @map("jnp_access_ok")
  jnpAccessCode           String    @default("") @map("jnp_access_code")
  jnpPackageEndDate       String    @default("") @map("jnp_package_end_date")
  jnpCheckedAt            DateTime? @map("jnp_checked_at")
  /// Legacy single-signature fields — migrated into EmailSignature rows; kept for one-time backfill.
  emailSignatureName      String    @default("Default") @map("email_signature_name")
  emailSignatureBody      String    @default("") @map("email_signature_body")
  emailSignatureEnabled   Boolean   @default(true) @map("email_signature_enabled")

  memberships         Membership[]
  ownedPeople         Person[]              @relation("PersonOwner")
  coOwnedPeople       PersonCoOwner[]
  ownedOrganizations  Organization[]        @relation("OrganizationOwner")
  tasks               Task[]
  activityEvents      ActivityEvent[]       @relation("ActivityEventActor")
  agentMap            VioTalkAgentMap?
  mailboxMap          MailboxMap?
  jnpMap              JnpUserMap?
  ownershipRequested  OwnershipRequest[]    @relation("OwnershipRequester")
  ownershipTarget     OwnershipRequest[]    @relation("OwnershipTarget")
  assignedReqs        RequirementRecruiter[]
  bdms                Requirement[]         @relation("RequirementBdm")
  organizedEvents     CalendarEvent[]       @relation("CalendarOrganizer")
  emailSignatures     EmailSignature[]

  @@unique([tenantId, email])
  @@map("users")
  @@schema("talentbridge")
}

/// Personal Outlook identity footers (not a message template catalog). One per user may be isDefault.
model EmailSignature {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("Default")
  body      String   @default("")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, userId])
  @@map("email_signatures")
  @@schema("talentbridge")
}

model Membership {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TbRole
  permissions String[] @default([])

  @@unique([tenantId, userId])
  @@map("memberships")
  @@schema("talentbridge")
}

model Organization {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  industry   String   @default("")
  location   String   @default("")
  status     String   @default("active")
  ownerId    String   @map("owner_id")
  owner      User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  lastOutreachAt DateTime? @map("last_outreach_at")
  createdAt  DateTime @default(now()) @map("created_at")

  roles          OrganizationRole[]
  affiliations   PersonOrganizationAffiliation[]
  requirements   Requirement[]
  submissions    Submission[]
  msaDocuments   MsaDocument[]
  purchaseOrders PurchaseOrder[]
  files          StoredFile[]
  activityEvents ActivityEvent[]
  tasks          Task[]
  interviews     Interview[]
  placements     Placement[]
  calendarEvents CalendarEvent[]

  @@index([tenantId, lastOutreachAt])
  @@index([tenantId, ownerId])
  @@index([tenantId, status])
  @@map("organizations")
  @@schema("talentbridge")
}

model OrganizationRole {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrganizationRoleKind

  @@unique([organizationId, role])
  @@map("organization_roles")
  @@schema("talentbridge")
}

model Person {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind            PersonKind
  stage           String      @default("Lead")
  status          String      @default("Active")
  name            String
  title           String      @default("")
  department      String      @default("")
  email           String      @default("")
  phone           String      @default("")
  /// Lowercased trimmed email for match / collision checks (not display).
  emailNormalized String      @default("") @map("email_normalized")
  /// Digits-only phone for match / collision checks (not display).
  phoneNormalized String      @default("") @map("phone_normalized")
  location        String      @default("")
  linkedIn        String      @default("") @map("linkedin")
  source          String      @default("manual")
  ownerId         String      @map("owner_id")
  owner           User        @relation("PersonOwner", fields: [ownerId], references: [id])
  doNotReach    Boolean     @default(false) @map("do_not_reach")
  doNotEmail      Boolean     @default(false) @map("do_not_email")
  doNotSms        Boolean     @default(false) @map("do_not_sms")
  availability    String      @default("")
  experienceYears Int         @default(0) @map("experience_years")
  skills          String[]    @default([])
  /// Label or external resume resource id — not resume file content / public URL.
  lastResume      String      @default("") @map("last_resume")
  secondaryTitle  String      @default("") @map("secondary_title")
  citizenship     String      @default("")
  workAuthorization String    @default("") @map("work_authorization")
  visaExpiry      DateTime?   @map("visa_expiry")
  willingToRelocate String    @default("") @map("willing_to_relocate")
  preferredLocation String    @default("") @map("preferred_location")
  noticePeriod    String      @default("") @map("notice_period")
  employmentType  String      @default("") @map("employment_type")
  currentRate     String      @default("") @map("current_rate")
  expectedRate    String      @default("") @map("expected_rate")
  timezone        String      @default("")
  lastOutreachAt   DateTime?   @map("last_outreach_at")
  nextAction      String      @default("")
  nextActionDueAt DateTime?   @map("next_action_due_at")
  portalCandidateId String?   @unique @map("portal_candidate_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  coOwners         PersonCoOwner[]
  affiliations     PersonOrganizationAffiliation[]
  titleIndex       TitleIndex?
  candidateSubs    Submission[]     @relation("SubmissionCandidate")
  clientPersonSubs Submission[]    @relation("SubmissionClientPerson")
  hiringManagerReqs Requirement[]   @relation("RequirementHiringManager")
  activityEvents   ActivityEvent[]
  tasks            Task[]
  files            StoredFile[]
  interviews       Interview[]
  placements       Placement[]
  ownershipReqs    OwnershipRequest[] @relation("OwnershipPerson")
  calendarEvents   CalendarEvent[]

  @@index([tenantId, kind])
  @@index([tenantId, emailNormalized])
  @@index([tenantId, phoneNormalized])
  /// List/sort + SLA stale-person paths
  @@index([tenantId, lastOutreachAt])
  /// Candidate Search filters (owner / source / stage / experience)
  @@index([tenantId, ownerId])
  @@index([tenantId, source])
  @@index([tenantId, stage])
  @@index([tenantId, experienceYears])
  /// Array containment (`skills has …`)
  @@index([skills], type: Gin, map: "people_skills_gin_idx")
  @@map("people")
  @@schema("talentbridge")
}

/// Stable cross-system ids (JobsNProfiles, etc.) without cloning ATS records.
model ExternalEntityLink {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType         String    @map("entity_type")
  entityId           String    @map("entity_id")
  externalSystem     String    @map("external_system")
  externalEntityType String    @default("") @map("external_entity_type")
  externalId         String    @map("external_id")
  externalUrl        String    @default("") @map("external_url")
  lastSyncedAt       DateTime? @map("last_synced_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, entityType, entityId, externalSystem, externalEntityType])
  @@index([tenantId, externalSystem, externalId])
  @@map("external_entity_links")
  @@schema("talentbridge")
}

model PersonCoOwner {
  id       String @id @default(uuid())
  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([personId, userId])
  @@map("person_co_owners")
  @@schema("talentbridge")
}

model PersonOrganizationAffiliation {
  id                   String       @id @default(uuid())
  organizationId       String       @map("organization_id")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId             String       @map("person_id")
  person               Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleOnOrganization   String       @default("") @map("role_on_organization")

  @@unique([organizationId, personId])
  @@map("person_organization_affiliations")
  @@schema("talentbridge")
}

model Requirement {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId  String             @map("organization_id")
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String
  skills          String[]           @default([])
  location        String             @default("")
  hiringManagerId String?            @map("hiring_manager_id")
  hiringManager   Person?            @relation("RequirementHiringManager", fields: [hiringManagerId], references: [id])
  bdmId           String             @map("bdm_id")
  bdm             User               @relation("RequirementBdm", fields: [bdmId], references: [id])
  status          RequirementStatus  @default(open)
  openedAt        DateTime           @default(now()) @map("opened_at")
  targetFillAt    DateTime?          @map("target_fill_at")
  portalJobId     String?            @map("portal_job_id")
  createdAt       DateTime           @default(now()) @map("created_at")

  recruiters     RequirementRecruiter[]
  submissions    Submission[]
  activityEvents ActivityEvent[]
  tasks          Task[]
  interviews     Interview[]
  placements     Placement[]
  calendarEvents CalendarEvent[]

  @@index([tenantId, status])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, openedAt])
  @@index([skills], type: Gin, map: "requirements_skills_gin_idx")
  @@map("requirements")
  @@schema("talentbridge")
}

model RequirementRecruiter {
  id            String      @id @default(uuid())
  requirementId String      @map("requirement_id")
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requirementId, userId])
  @@map("requirement_recruiters")
  @@schema("talentbridge")
}

model Submission {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidateId     String       @map("candidate_id")
  candidate       Person       @relation("SubmissionCandidate", fields: [candidateId], references: [id])
  requirementId   String       @map("requirement_id")
  requirement     Requirement  @relation(fields: [requirementId], references: [id])
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  clientPersonId String       @map("client_person_id")
  clientPerson   Person       @relation("SubmissionClientPerson", fields: [clientPersonId], references: [id])
  recruiterId     String       @map("recruiter_id")
  bdmId           String       @map("bdm_id")
  stage           String       @default("Submitted")
  emailMessageId  String?      @map("email_message_id")
  resumeVersion   String       @default("") @map("resume_version")
  sentAt          DateTime     @default(now()) @map("sent_at")
  source          String       @default("hub")
  vendorSourced   Boolean      @default(false) @map("vendor_sourced")
  createdAt       DateTime     @default(now()) @map("created_at")

  activityEvents ActivityEvent[]
  interviews     Interview[]
  placements     Placement[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([tenantId, stage])
  /// Exclude-already-submitted + candidate history
  @@index([tenantId, requirementId])
  @@index([tenantId, candidateId])
  @@index([tenantId, organizationId, stage])
  @@index([tenantId, sentAt])
  @@map("submissions")
  @@schema("talentbridge")
}

model Interview {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidateId    String       @map("candidate_id")
  candidate      Person       @relation(fields: [candidateId], references: [id])
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  requirementId  String       @map("requirement_id")
  requirement    Requirement  @relation(fields: [requirementId], references: [id])
  submissionId   String?      @map("submission_id")
  submission     Submission?  @relation(fields: [submissionId], references: [id])
  scheduledAt    DateTime     @map("scheduled_at")
  endsAt         DateTime?    @map("ends_at")
  location       String       @default("")
  teamsJoinUrl   String       @default("") @map("teams_join_url")
  graphEventId   String?      @map("graph_event_id")
  feedbackAt     DateTime?    @map("feedback_at")
  outcome        String       @default("pending")
  createdAt      DateTime     @default(now()) @map("created_at")

  calendarEvents CalendarEvent[]

  @@index([tenantId, outcome, scheduledAt])
  @@index([tenantId, candidateId])
  @@map("interviews")
  @@schema("talentbridge")
}

model Placement {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidateId    String       @map("candidate_id")
  candidate      Person       @relation(fields: [candidateId], references: [id])
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  requirementId  String       @map("requirement_id")
  requirement    Requirement  @relation(fields: [requirementId], references: [id])
  submissionId   String?      @map("submission_id")
  submission     Submission?  @relation(fields: [submissionId], references: [id])
  ownerId        String       @map("owner_id")
  startDate      DateTime     @map("start_date")
  endDate        DateTime?    @map("end_date")
  followUp       String       @default("") @map("follow_up")
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([tenantId, candidateId])
  @@map("placements")
  @@schema("talentbridge")
}

model ActivityEvent {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind           String
  summary        String
  body           String   @default("")
  source         String   @default("talentbridge")
  externalId     String?  @map("external_id")
  actorId        String?  @map("actor_id")
  actor          User?    @relation("ActivityEventActor", fields: [actorId], references: [id])
  personId       String?  @map("person_id")
  person         Person?  @relation(fields: [personId], references: [id])
  organizationId String?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  requirementId  String?  @map("requirement_id")
  requirement    Requirement? @relation(fields: [requirementId], references: [id])
  submissionId   String?  @map("submission_id")
  submission     Submission? @relation(fields: [submissionId], references: [id])
  wrapUp         WrapUpOutcome? @map("wrap_up")
  recordingRef   String?  @map("recording_ref")
  transcriptRef  String?  @map("transcript_ref")
  aiSummary      String?  @map("ai_summary")
  causedTaskId   String?  @map("caused_task_id")
  createdAt      DateTime @default(now()) @map("created_at")

  insights Insight[]
  tasks    Task[]

  @@index([tenantId, createdAt])
  /// Communications inbox (open wrap-ups) + person/org timelines
  @@index([tenantId, wrapUp, createdAt])
  @@index([tenantId, personId, createdAt])
  @@index([tenantId, organizationId, createdAt])
  @@index([tenantId, externalId])
  @@map("activity_events")
  @@schema("talentbridge")
}

model Task {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  status         String    @default("open")
  priority       String    @default("normal")
  dueAt          DateTime? @map("due_at")
  ownerId        String    @map("owner_id")
  owner          User      @relation(fields: [ownerId], references: [id])
  personId       String?   @map("person_id")
  person         Person?   @relation(fields: [personId], references: [id])
  organizationId String?   @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  requirementId  String?   @map("requirement_id")
  requirement    Requirement? @relation(fields: [requirementId], references: [id])
  submissionId   String?   @map("submission_id")
  submission     Submission? @relation(fields: [submissionId], references: [id])
  sourceEventId  String?   @map("source_event_id")
  sourceEvent    ActivityEvent? @relation(fields: [sourceEventId], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")
  calendarEvents CalendarEvent[]

  @@index([tenantId, status, dueAt])
  @@index([tenantId, ownerId, status, dueAt])
  @@index([tenantId, personId, status])
  @@map("tasks")
  @@schema("talentbridge")
}

model CalendarEvent {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  kind           String
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  location       String   @default("")
  teamsJoinUrl   String   @default("") @map("teams_join_url")
  graphEventId   String?  @map("graph_event_id")
  organizerId    String   @map("organizer_id")
  organizer      User     @relation("CalendarOrganizer", fields: [organizerId], references: [id])
  personId       String?  @map("person_id")
  person         Person?  @relation(fields: [personId], references: [id])
  organizationId String?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  requirementId  String?  @map("requirement_id")
  requirement    Requirement? @relation(fields: [requirementId], references: [id])
  submissionId   String?  @map("submission_id")
  submission     Submission? @relation(fields: [submissionId], references: [id])
  interviewId    String?  @map("interview_id")
  interview      Interview? @relation(fields: [interviewId], references: [id])
  taskId         String?  @map("task_id")
  task           Task?    @relation(fields: [taskId], references: [id])
  attendees      String[] @default([])
  body           String   @default("")
  source         String   @default("hub")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, startsAt])
  @@index([tenantId, personId, startsAt])
  @@index([tenantId, graphEventId])
  @@map("calendar_events")
  @@schema("talentbridge")
}

model Insight {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            String
  sourceEventId   String?       @map("source_event_id")
  sourceEvent     ActivityEvent? @relation(fields: [sourceEventId], references: [id])
  suggestedTaskId String?       @map("suggested_task_id")
  confidence      Float         @default(0)
  status          InsightStatus @default(proposed)
  payload         String        @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("insights")
  @@schema("talentbridge")
}

model StoredFile {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind           String   @default("other")
  name           String
  /// manual | JobsNProfiles — where this file reference came from.
  source         String   @default("manual")
  /// External system id (e.g. JNP resume_id) when source is JobsNProfiles.
  externalId     String?  @map("external_id")
  version        Int      @default(1)
  organizationId String?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  personId       String?  @map("person_id")
  person         Person?  @relation(fields: [personId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, personId])
  @@index([tenantId, organizationId])
  @@index([tenantId, personId, source, externalId])
  @@map("files")
  @@schema("talentbridge")
}

model MsaDocument {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  number         String
  status         String       @default("active")
  expiresAt      DateTime?    @map("expires_at")
  noticeDays     Int          @default(30) @map("notice_days")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId, expiresAt])
  @@index([tenantId, organizationId])
  @@map("msa_documents")
  @@schema("talentbridge")
}

model PurchaseOrder {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  number         String
  status         String       @default("active")
  ceiling        Decimal      @default(0)
  utilized       Decimal      @default(0)
  expectedExhaustion DateTime? @map("expected_exhaustion")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([tenantId, organizationId])
  @@map("purchase_orders")
  @@schema("talentbridge")
}

model Provenance {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id")
  field           String
  sourceSystem    String    @map("source_system")
  externalId      String?   @map("external_id")
  sourceTimestamp DateTime? @map("source_timestamp")
  lastSyncedAt    DateTime? @map("last_synced_at")
  syncStatus      String    @default("ok") @map("sync_status")
  updatedBy       String    @map("updated_by")
  manualOverride  Boolean   @default(false) @map("manual_override")

  @@index([tenantId, entityType, entityId])
  @@map("provenance")
  @@schema("talentbridge")
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     String   @default("")
  after      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_events")
  @@schema("talentbridge")
}

/// Global Admin (Admin-Talent-Bridge) actions — not tenant-scoped workspace audit.
model PlatformAuditEvent {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  /// Optional related tenant for create/enable/invite ops.
  tenantId   String?  @map("tenant_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     String   @default("")
  after      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("platform_audit_events")
  @@schema("talentbridge")
}

/// Transactional email delivery from Admin / platform flows (invite, reset, notices).
model PlatformEmailLog {
  id            String   @id @default(uuid())
  kind          String
  toEmail       String   @map("to_email")
  subject       String
  status        String
  providerId    String   @default("") @map("provider_id")
  error         String   @default("")
  tenantId      String?  @map("tenant_id")
  actorId       String?  @map("actor_id")
  relatedUserId String?  @map("related_user_id")
  previewUrl    String   @default("") @map("preview_url")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([toEmail, createdAt])
  @@map("platform_email_logs")
  @@schema("talentbridge")
}

/// Global Admin login attempts (success and failure).
model PlatformLoginEvent {
  id              String   @id @default(uuid())
  platformAdminId String?  @map("platform_admin_id")
  email           String
  success         Boolean
  reason          String   @default("")
  ip              String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([platformAdminId, createdAt])
  @@map("platform_login_events")
  @@schema("talentbridge")
}

model TitleIndex {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personId         String   @unique @map("person_id")
  person           Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  currentTitle     String   @default("") @map("current_title")
  previousTitles   String[] @default([]) @map("previous_titles")
  resumeTitles     String[] @default([]) @map("resume_titles")
  normalizedTitleId String? @map("normalized_title_id")
  relatedTitleIds  String[] @default([]) @map("related_title_ids")
  skills           String[] @default([])
  lastIndexedAt    DateTime @default(now()) @map("last_indexed_at")

  @@index([tenantId])
  @@index([skills], type: Gin, map: "title_indexes_skills_gin_idx")
  @@index([previousTitles], type: Gin, map: "title_indexes_previous_titles_gin_idx")
  @@index([resumeTitles], type: Gin, map: "title_indexes_resume_titles_gin_idx")
  @@map("title_indexes")
  @@schema("talentbridge")
}

model OwnershipRequest {
  id         String                 @id @default(uuid())
  tenantId   String                 @map("tenant_id")
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personId   String                 @map("person_id")
  person     Person                 @relation("OwnershipPerson", fields: [personId], references: [id])
  requesterId String                @map("requester_id")
  requester  User                   @relation("OwnershipRequester", fields: [requesterId], references: [id])
  targetOwnerId String              @map("target_owner_id")
  targetOwner User                  @relation("OwnershipTarget", fields: [targetOwnerId], references: [id])
  type       OwnershipRequestType
  status     OwnershipRequestStatus @default(pending)
  note       String                 @default("")
  createdAt  DateTime               @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([tenantId, personId, status])
  @@map("ownership_requests")
  @@schema("talentbridge")
}

model ExceptionItem {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       ExceptionKind
  title      String
  detail     String        @default("")
  status     String        @default("open")
  payload    String        @default("{}")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([tenantId, status, createdAt])
  @@map("exception_items")
  @@schema("talentbridge")
}

model VioTalkAgentMap {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String @unique @map("user_id")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vioTalkUserId  String @map("viotalk_user_id")
  assignedNumber String @map("assigned_number")

  @@map("viotalk_agent_maps")
  @@schema("talentbridge")
}

model MailboxMap {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String @unique @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailbox   String

  @@map("mailbox_maps")
  @@schema("talentbridge")
}

/// Maps a TalentBridge user to a JobsNProfiles employer/recruiter id (jnp_users.id).
model JnpUserMap {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String @unique @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jnpUserId String @map("jnp_user_id")

  @@index([tenantId])
  @@map("jnp_user_maps")
  @@schema("talentbridge")
}
